# Copy to .env (gitignored). Token matches the HydraDB OSS local-dev file.
# Compose also reads UID/GID from .env for user: "${UID}:${GID}".
#   ./scripts/init-hydradb-data.sh

HYDRA_BOLT_URI=bolt://127.0.0.1:7687
HYDRA_HTTP_URI=http://127.0.0.1:8443
HYDRA_AUTH_TOKEN=local-development-token-32-bytes
HYDRA_GRAPH_ID=default
HYDRA_NAMESPACE=default
HYDRA_CELL_ID=cell-0

# UID=
# GID=
